        .g-frict-in {
          display: block;
          font-size: 68px;
          font-weight: 800;
          line-height: 92px;
          letter-spacing: -0.03em;
          color: rgba(255, 255, 255, 0.42);
          white-space: nowrap;
        }

        .g-strike {
          position: absolute;
          left: 96px;
          height: 7px;
          background: #ff5a1f;
          transform-origin: left center;
        }

        #g-strike-1 {
          top: 358px;
          width: 800px;
        }
        #g-strike-2 {
          top: 450px;
