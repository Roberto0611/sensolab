  <body>
    <template>
      <style>
        #root {
          position: absolute;
          inset: 0;
          font-family: Inter, "Segoe UI", system-ui, sans-serif;
          color: #ffffff;
          overflow: hidden;
        }

        /* ---------- colour field ---------- */
        #g-field {
