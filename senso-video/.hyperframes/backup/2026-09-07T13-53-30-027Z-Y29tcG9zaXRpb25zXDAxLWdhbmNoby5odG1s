        }

        #g-headline {
          position: absolute;
          left: 96px;
          top: 308px;
          width: 1400px;
        }

        .g-mask {
          display: block;
          overflow: hidden;
          height: 94px;
        }

        .g-line {
          display: block;
          font-size: 84px;
          font-weight: 900;
          line-height: 94px;
          letter-spacing: -0.042em;
          white-space: nowrap;
          text-transform: uppercase;
        }

        .g-accent {
          color: #ff5a1f;
        }

        #g-sub {
          position: absolute;
          left: 96px;
          top: 672px;
