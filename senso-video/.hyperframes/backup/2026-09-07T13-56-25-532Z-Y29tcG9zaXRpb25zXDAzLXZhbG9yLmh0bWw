        <div data-hf-id="hf-wh4b" id="v-summary">
          Un panel <b data-hf-id="hf-6fue">más grande, mejor calificado y mejor documentado</b> — sin sumar
          carga administrativa.
        </div>
      </div>

      <script>
        (function () {
          const tl = gsap.timeline({ paused: true });
          const cards = ["#v-card-1", "#v-card-2", "#v-card-3"];

          gsap.set("#v-summary", { autoAlpha: 0 });
          gsap.set(cards, { autoAlpha: 0 });

          // 0.00 — teal field wipes the demo away.
          tl.fromTo(
            "#v-field",
            { xPercent: -120 },
            { xPercent: 0, duration: 0.45, ease: "expo.out" },
            0,
          );
          tl.fromTo(
            "#v-band",
            { xPercent: 120 },
            { xPercent: 0, duration: 0.55, ease: "expo.out" },
            0.1,
          );

          // 0.25 — label + headline.
          tl.fromTo(
            "#v-eyebrow",
            { x: -20, autoAlpha: 0 },
            { x: 0, autoAlpha: 1, duration: 0.32, ease: "expo.out" },
            0.25,
          );
          tl.fromTo(
            "#v-l1",
            { yPercent: 105 },
            { yPercent: 0, duration: 0.5, ease: "expo.out" },
            0.35,
          );

          // 1.05 / 1.95 / 2.85 — the rule of three, hard cuts, one colour each.
          cards.forEach(function (card, i) {
            const t = 0.72 + i * 0.78;
            tl.set(card, { autoAlpha: 1 }, t);
            tl.fromTo(
              card,
              { yPercent: 106 },
              { yPercent: 0, duration: 0.52, ease: "expo.out" },
              t,
            );
            tl.fromTo(
              card + " .v-card-num",
              { autoAlpha: 0 },
              { autoAlpha: 1, duration: 0.25, ease: "none" },
              t + 0.2,
            );
            tl.fromTo(
              card + " .v-card-title",
              { yPercent: 30, autoAlpha: 0 },
              { yPercent: 0, autoAlpha: 1, duration: 0.4, ease: "expo.out" },
              t + 0.22,
            );
            tl.fromTo(
              card + " .v-card-body",
              { yPercent: 24, autoAlpha: 0 },
              { yPercent: 0, autoAlpha: 1, duration: 0.42, ease: "expo.out" },
              t + 0.32,
            );
            // Each card keeps breathing so the trio never freezes.
            tl.fromTo(
              card + " .v-card-ghost",
              { x: 0 },
              { x: -34, duration: 6.4, ease: "sine.inOut" },
              t + 0.6,
            );
          });

          // 4.4 — the takeaway.
          tl.fromTo(
            "#v-summary",
            { y: 26, autoAlpha: 0 },
            { y: 0, autoAlpha: 1, duration: 0.45, ease: "expo.out" },
            3.4,
          );

          // Slow band drift under the trio.
          tl.fromTo("#v-band", { x: 0 }, { x: -60, duration: 8, ease: "sine.inOut" }, 1.2);

          // 9.7 — cards drop out fast for the brand card.
          tl.to(
            cards,
            { yPercent: -110, duration: 0.42, stagger: 0.06, ease: "power3.in" },
            9.65,
          );
          tl.to(
            ["#v-eyebrow", "#v-head", "#v-summary"],
            { autoAlpha: 0, duration: 0.3, ease: "power2.in" },
            9.8,
          );

          // 10.15 — act 4's wipe already covers the frame; clear this one.
          tl.set(
            ["#v-field", "#v-band", "#v-eyebrow", "#v-head", "#v-summary", "#v-cards"],
            { autoAlpha: 0 },
            10.15,
          );

          window.__timelines["valor"] = tl;
        })();
      </script>
    </template>
