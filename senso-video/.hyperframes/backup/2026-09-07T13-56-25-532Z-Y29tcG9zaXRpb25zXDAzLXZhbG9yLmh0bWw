      <div data-hf-id="hf-3ugz" id="root" data-composition-id="valor" data-width="1920" data-height="1080">
        <div data-hf-id="hf-igyh" id="v-field" data-layout-allow-overflow="true"></div>
        <div data-hf-id="hf-fvk6" id="v-band" data-layout-allow-overflow="true"></div>

        <div data-hf-id="hf-1txv" id="v-eyebrow">Lo que gana Sensolab</div>

        <h2 data-hf-id="hf-5v21" id="v-head">
          <span data-hf-id="hf-msgm" class="v-mask"><span data-hf-id="hf-kq98" id="v-l1" class="v-line">Tres ganancias inmediatas.</span></span>
        </h2>

