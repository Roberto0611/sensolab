      <script>
        (function () {
          const tl = gsap.timeline({ paused: true });

          // Scroll travel per screen = captured page height - 844px viewport.
          const SEGMENTS = [
            { i: 1, scroll: -700, ghost: "01" },
            { i: 2, scroll: -740, ghost: "02" },
            { i: 3, scroll: -1320, ghost: "03" },
            { i: 4, scroll: -680, ghost: "04" },
          ];
          const SEG = 7.5;

          gsap.set(["#d-seg-1", "#d-seg-2", "#d-seg-3", "#d-seg-4"], { autoAlpha: 0 });
          gsap.set(["#d-plate-2", "#d-plate-3", "#d-plate-4"], { autoAlpha: 0 });
          gsap.set(
            ["#d-callout-1", "#d-callout-2", "#d-callout-3", "#d-callout-4"],
            { autoAlpha: 0 },
          );
          gsap.set(["#d-dot-fill-1", "#d-dot-fill-2", "#d-dot-fill-3", "#d-dot-fill-4"], {
            scaleX: 0,
          });
          // Fields 2-4 wait offstage; field 1 wipes in with the act.
          gsap.set(["#d-field-2", "#d-field-3", "#d-field-4"], { xPercent: -120 });

          // --- phone: hard entrance, then it holds while the colour changes behind it ---
          tl.fromTo(
            "#d-phone",
            { x: 170, rotationY: -20, autoAlpha: 0 },
            { x: 0, rotationY: -6, autoAlpha: 1, duration: 0.7, ease: "expo.out" },
            0.12,
          );
          tl.to("#d-phone", { rotationY: 6, duration: 14, ease: "sine.inOut" }, 1.2);
          tl.to("#d-phone", { rotationY: -4, duration: 13, ease: "sine.inOut" }, 15.2);
          tl.fromTo("#d-phone-stage", { y: 0 }, { y: -20, duration: 28, ease: "sine.inOut" }, 0.8);

          tl.fromTo(
            "#d-kicker",
            { x: -18, autoAlpha: 0 },
            { x: 0, autoAlpha: 1, duration: 0.35, ease: "expo.out" },
            0.2,
          );
          tl.fromTo(
            "#d-steps",
            { y: 18, autoAlpha: 0 },
            { y: 0, autoAlpha: 1, duration: 0.35, ease: "expo.out" },
            0.3,
          );

          SEGMENTS.forEach(function (seg, idx) {
            const t = idx * SEG;
            const s = "#d-seg-" + seg.i;
            const lines = s + " .d-line";

            // --- colour field wipes in BEHIND the phone: the scene changes, the device does not ---
            tl.fromTo(
              "#d-field-" + seg.i,
              { xPercent: -120 },
              { xPercent: 0, duration: idx === 0 ? 0.45 : 0.5, ease: "expo.out" },
              t,
            );
            // The slab keeps drifting all segment so no frame is ever static.
            tl.fromTo(
              "#d-slab-" + seg.i,
              { x: 70 },
              { x: -50, duration: SEG, ease: "sine.inOut" },
              t + 0.2,
            );

            // --- screen swap + a real device flick ---
            if (idx > 0) {
              tl.to(
                "#d-plate-" + SEGMENTS[idx - 1].i,
                { xPercent: -100, autoAlpha: 0, duration: 0.45, ease: "power3.inOut" },
                t,
              );
              tl.fromTo(
                "#d-plate-" + seg.i,
                { xPercent: 100, autoAlpha: 1 },
                { xPercent: 0, autoAlpha: 1, duration: 0.52, ease: "expo.out" },
                t + 0.03,
              );
              tl.to("#d-phone", { scale: 0.968, duration: 0.16, ease: "power2.out" }, t);
              tl.to("#d-phone", { scale: 1, duration: 0.42, ease: "expo.out" }, t + 0.16);
            }

            // --- the scroll: the part that sells it ---
            tl.fromTo(
              "#d-shot-" + seg.i,
              { y: 0 },
              { y: seg.scroll, duration: 5.2, ease: "sine.inOut" },
              t + 0.95,
            );

            // --- ghost numeral flips with the segment ---
            tl.set("#d-ghost", { innerText: seg.ghost }, t + 0.06);
            tl.fromTo(
              "#d-ghost",
              { yPercent: 12, autoAlpha: 0 },
              { yPercent: 0, autoAlpha: 1, duration: 0.5, ease: "expo.out" },
              t + 0.08,
            );
            tl.to("#d-ghost", { autoAlpha: 0, duration: 0.3, ease: "power2.in" }, t + 6.9);

            // --- copy: number, two masked lines, one note ---
            tl.set(s, { autoAlpha: 1 }, t + 0.12);
            tl.fromTo(
              s + " .d-num",
              { x: -22, autoAlpha: 0 },
              { x: 0, autoAlpha: 1, duration: 0.35, ease: "expo.out" },
              t + 0.15,
            );
            tl.fromTo(
              lines,
              { yPercent: 105 },
              { yPercent: 0, duration: 0.46, stagger: 0.09, ease: "expo.out" },
              t + 0.28,
            );
            tl.fromTo(
              "#d-note-" + seg.i,
              { x: -26, autoAlpha: 0 },
              { x: 0, autoAlpha: 1, duration: 0.42, ease: "expo.out" },
              t + 0.82,
            );

            // --- callout snaps in beside the phone ---
            tl.fromTo(
              "#d-callout-" + seg.i,
              { xPercent: 12, autoAlpha: 0 },
              { xPercent: 0, autoAlpha: 1, duration: 0.32, ease: "expo.out" },
              t + 2.4,
            );
            tl.to(
              "#d-callout-" + seg.i,
              { xPercent: 8, autoAlpha: 0, duration: 0.26, ease: "power2.in" },
              t + 5.9,
            );

            // --- step bar fills across the segment ---
            tl.fromTo(
              "#d-dot-fill-" + seg.i,
              { scaleX: 0 },
              { scaleX: 1, duration: SEG - 0.3, ease: "none" },
              t + 0.15,
            );

            // --- copy snaps out on the cut ---
            const outAt = idx === SEGMENTS.length - 1 ? t + 6.9 : t + 6.62;
            tl.to(
              lines,
              { yPercent: -105, duration: 0.34, stagger: 0.05, ease: "power3.in" },
              outAt,
            );
            tl.to(
              [s + " .d-num", "#d-note-" + seg.i],
              { x: -26, autoAlpha: 0, duration: 0.3, ease: "power3.in" },
              outAt,
            );
            tl.set(s, { autoAlpha: 0 }, outAt + 0.42);
          });

          // Act hand-off — everything clears fast for the value cards.
          tl.to("#d-steps", { autoAlpha: 0, duration: 0.28, ease: "power2.in" }, 29.5);
          tl.to("#d-kicker", { autoAlpha: 0, duration: 0.28, ease: "power2.in" }, 29.5);
          tl.to(
            "#d-phone",
            { x: -110, rotationY: 18, autoAlpha: 0, duration: 0.55, ease: "power3.in" },
            29.45,
          );

          // 30.15 — act 3's wipe already covers the frame; clear this one.
          tl.set(["#d-copy", "#d-steps", "#d-phone-stage", "#d-fields"], { autoAlpha: 0 }, 30.15);

          window.__timelines["demo"] = tl;
        })();
      </script>
